    {
      "document_type": "course",
      "title": "DSC1001 official course facts and indicative assessment",
      "content": "DSC1001 Introduction to Data Science. Offering Academic Unit: Department of Data Science. Credit Units: 2. Course Duration: One Semester. Equivalent Course(s): SDSC1001. Course Offering Term: Semester A 2026/27. Course aims: introduce data science through data-driven modelling, case studies, projects, written reports and oral presentations. Assessment (Indicative only; check detailed course information): Continuous Assessment 80%; Examination 20%; examination duration 1 hour; minimum continuous assessment passing requirement 30%; minimum examination passing requirement 30%. To pass, overall mark must be at least 40% and both components must be at least 30%.",
      "source_url": "https://www.cityu.edu.hk/catalogue/ug/current/course/DSC1001.htm",
      "course_code": "DSC1001",
      "catalogue_year": "2026/27",
      "term_id": "2026-A",
      "source_status": "published"
    },
    {
      "document_type": "course",
      "title": "CS2334 official course facts and indicative assessment",
      "content": "CS2334 Data Structures for Data Science. Offering Academic Unit: Department of Computer Science. Credit Units: 3. Course Duration: One Semester. Prerequisite(s): CS2311 or CS2315 or CS1315. Exclusive Course(s): CS3334. Course Offering Term: Semester A 2026/27. Course aims: fundamentals of data structures, heaps, search trees, hash tables, disjoint sets, and mathematical analysis of algorithms. Assessment (Indicative only; check detailed course information): Continuous Assessment 40%; Examination 60%; examination duration 2 hours; minimum examination passing requirement 30%.",
      "source_url": "https://www.cityu.edu.hk/catalogue/ug/current/course/CS2334.htm",
      "course_code": "CS2334",
      "catalogue_year": "2026/27",
      "term_id": "2026-A",
      "source_status": "published"
    },
    {
      "document_type": "course",
      "title": "CS3201 official course facts and indicative assessment",
      "content": "CS3201 Computer Networks. Offering Academic Unit: Department of Computer Science. Credit Units: 3. Course Duration: One Semester. Pre-cursor(s): CS2310 or CS2311 or CS2315 or CS2360 or CS2334. Course Offering Term: Semester A 2026/27; the offering term is subject to change without prior notice. Course aims: fundamental data communication and computer networks, with the five-layer architecture and transport layer as the main focus. Assessment (Indicative only; check detailed course information): Continuous Assessment 30%; Examination 70%; examination duration 2 hours; minimum examination passing requirement 30%.",
      "source_url": "https://www.cityu.edu.hk/catalogue/ug/current/course/CS3201.htm",
      "course_code": "CS3201",
      "catalogue_year": "2026/27",
      "term_id": "2026-A",
      "source_status": "published"
    },
    {
      "document_type": "programme_rule",
      "title": "BSc Data Science normative programme catalogue notes",
      "content": "The CityU BSc Data Science normative 4-year degree page states 121 credit units are required for graduation. The page notes that curriculum information is subject to periodic review and changes. Its current page labels major requirements with catalogue term Semester A 2027/28; the effective term of the declared or allocated major determines which major requirement applies. Core examples include DSC1001, DSC2001, DSC2002, DSC2004, DSC2005, DSC2102, CS2334, CS3273, DSC3006, DSC3007 and DSC4116. Electives include DSC/CS choices, with at least 12 credit units from B4-level courses. This document is evidence for explanation only until a student's applicable catalogue year is confirmed.",
      "source_url": "https://www.cityu.edu.hk/catalogue/ug/current/Major/BSC1_DSC-1.htm",
      "catalogue_year": "2027/28",
      "source_status": "published"
    }
